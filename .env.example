# Copy this to .env.local and fill in values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser — keep secrets
# in the non-prefixed vars (Notion token, reCAPTCHA secret, GitHub token).

# ─── Notion (required for Work / Publications / Honors / contact form) ───
NOTION_TOKEN=
PROJECTS_DATABASE_ID=
HONORS_DATABASE_ID=
PUBLICATIONS_DATABASE_ID=
QUESTION_FORM_DATABASE_ID=
# Optional: enable the Writing section.
# BLOG_DATABASE_ID=

# ─── reCAPTCHA v3 (required — contact form) ───
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Umami analytics (optional) ───
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=

# ─── Identity (rendered in hero/about/nav) ───
NEXT_PUBLIC_NAME=
NEXT_PUBLIC_TAGLINE=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_EMAIL=

# ─── Socials ───
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_GITHUB_USER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_SCHOLAR_URL=
NEXT_PUBLIC_SCHOLAR_USER=

# ─── GitHub fetching ───
# Optional token — raises REST rate limit from 60/h to 5k/h.
# GITHUB_TOKEN=
# Optional: pin specific repos in a specific order. Otherwise, the pinned
# repos from your public GitHub profile are used.
# GITHUB_PINNED_REPOS=repo-a,repo-b,repo-c
